---
// src/pages/padres/configuracion.astro
import '../../styles/global.css';
---

<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Configuración Familiar - Centro de Padres</title>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen pb-24 font-sans">

  <!-- Header -->
  <header class="bg-slate-800 border-b border-slate-700 p-4 sticky top-0 z-30">
    <div class="max-w-md mx-auto flex justify-between items-center">
      <a href="/padres/dashboard" class="text-slate-400 hover:text-white transition font-bold text-sm flex items-center gap-1">
        ← Volver
      </a>
      <h1 class="font-black text-white text-base">⚙️ Configuración Familiar</h1>
    </div>
  </header>

  <main class="max-w-md mx-auto p-4 space-y-5">

    <!-- Configuración del Perfil -->
    <section class="bg-slate-800 p-4 rounded-3xl border border-slate-700 space-y-3">
      <h2 class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-1.5">
        <span>🦸‍♂️</span> Perfil del Héroe
      </h2>

      <form id="profile-form" class="space-y-3">
        <div class="grid grid-cols-4 gap-2">
          <div class="col-span-1">
            <label class="block text-[10px] font-bold text-slate-400 mb-1">Avatar</label>
            <input type="text" id="profile-avatar" placeholder="👦" maxlength="2" class="w-full bg-slate-900 border border-slate-700 rounded-xl py-2 px-1 text-center text-base text-white outline-none focus:ring-2 focus:ring-purple-500" />
          </div>
          <div class="col-span-3">
            <label class="block text-[10px] font-bold text-slate-400 mb-1">Nombre</label>
            <input type="text" id="profile-name" placeholder="Ángel" required class="w-full bg-slate-900 border border-slate-700 rounded-xl py-2 px-3 text-xs text-white outline-none focus:ring-2 focus:ring-purple-500" />
          </div>
        </div>
        <button type="submit" class="w-full bg-purple-600 hover:bg-purple-500 text-white font-bold py-2 rounded-xl text-xs transition cursor-pointer">
          Guardar Nombre y Emoji
        </button>
      </form>
    </section>

    <!-- Personalización Visual Avanzada -->
    <section class="bg-slate-800 p-4 rounded-3xl border border-slate-700 space-y-4">
      <h2 class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-1.5">
        <span>🎨</span> Fotos e Imágenes
      </h2>

      <div class="space-y-2 pb-3 border-b border-slate-700">
        <label class="block text-xs font-bold text-slate-300">🖼️ Fondo de Pantalla</label>
        <input type="file" id="custom-bg-input" accept="image/*" class="w-full text-xs text-slate-400 file:mr-3 file:py-1.5 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-purple-500/20 file:text-purple-300 hover:file:bg-purple-500/30 border border-slate-700 rounded-xl p-1" />
        <button type="button" onclick="saveCustomBg()" class="w-full bg-slate-700 hover:bg-slate-600 text-white font-bold text-xs py-2 rounded-xl transition cursor-pointer">
          Guardar Fondo
        </button>
      </div>

      <div class="space-y-2">
        <label class="block text-xs font-bold text-slate-300">🦸‍♂️ Foto de Avatar Personalizada</label>
        <input type="file" id="custom-avatar-input" accept="image/*" class="w-full text-xs text-slate-400 file:mr-3 file:py-1.5 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-blue-500/20 file:text-blue-300 hover:file:bg-blue-500/30 border border-slate-700 rounded-xl p-1" />
        <button type="button" onclick="saveCustomAvatar()" class="w-full bg-slate-700 hover:bg-slate-600 text-white font-bold text-xs py-2 rounded-xl transition cursor-pointer">
          Guardar Foto de Avatar
        </button>
      </div>
    </section>

    <!-- Sincronización y Vincular Dispositivos -->
    <section class="bg-slate-800 p-4 rounded-3xl border border-slate-700 space-y-4">
      <h2 class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-1.5">
        <span>🤝</span> Vincular y Sincronizar
      </h2>

      <div class="space-y-2 pb-3 border-b border-slate-700">
        <label class="block text-xs font-bold text-slate-300">Código Familiar de este Dispositivo</label>
        <div class="flex gap-2">
          <input type="text" readonly value="HEROES-ANGEL-2026" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-xs font-mono font-bold text-slate-300" />
          <button type="button" onclick="copyCode()" class="bg-slate-700 hover:bg-slate-600 text-white font-bold text-xs px-3 py-2 rounded-xl shrink-0 cursor-pointer">Copiar</button>
        </div>
      </div>

      <div class="space-y-2">
        <label class="block text-xs font-bold text-slate-300">🔄 Sincronización Rápida por WhatsApp</label>
        <div class="flex gap-2">
          <button type="button" onclick="exportData()" class="w-1/2 bg-slate-700 hover:bg-slate-600 text-white font-bold text-xs py-2 rounded-xl transition cursor-pointer">📤 Copiar Datos</button>
          <button type="button" onclick="importData()" class="w-1/2 bg-purple-600 hover:bg-purple-500 text-white font-bold text-xs py-2 rounded-xl transition cursor-pointer">📥 Cargar Datos</button>
        </div>
      </div>
    </section>

  </main>

  <script>
    // @ts-nocheck
    const STORAGE_KEY = 'family_app_state_v1';

    function getState() {
      const saved = localStorage.getItem(STORAGE_KEY);
      return saved ? JSON.parse(saved) : { childProfile: {} };
    }

    document.addEventListener('DOMContentLoaded', () => {
      const state = getState();
      const profile = state.childProfile || {};

      const nameInput = document.getElementById('profile-name');
      const avatarInput = document.getElementById('profile-avatar');
      if (nameInput) nameInput.value = profile.name || 'Ángel';
      if (avatarInput) avatarInput.value = profile.avatar || '👦';

      document.getElementById('profile-form')?.addEventListener('submit', (e) => {
        e.preventDefault();
        const state = getState();
        if (!state.childProfile) state.childProfile = {};
        state.childProfile.name = nameInput.value;
        state.childProfile.avatar = avatarInput.value;
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
        alert('Perfil guardado correctamente.');
      });
    });

    window.saveCustomBg = function() {
      const fileInput = document.getElementById('custom-bg-input');
      if (!fileInput.files || fileInput.files.length === 0) return alert('Selecciona una imagen.');
      const reader = new FileReader();
      reader.onload = function(e) {
        const state = getState();
        if (!state.childProfile) state.childProfile = {};
        state.childProfile.customBgImage = e.target.result;
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
        alert('¡Fondo guardado con éxito!');
      };
      reader.readAsDataURL(fileInput.files[0]);
    };

    window.saveCustomAvatar = function() {
      const fileInput = document.getElementById('custom-avatar-input');
      if (!fileInput.files || fileInput.files.length === 0) return alert('Selecciona una imagen.');
      const reader = new FileReader();
      reader.onload = function(e) {
        const state = getState();
        if (!state.childProfile) state.childProfile = {};
        state.childProfile.customAvatarImage = e.target.result;
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
        alert('¡Avatar guardado con éxito!');
      };
      reader.readAsDataURL(fileInput.files[0]);
    };

    window.copyCode = function() {
      navigator.clipboard.writeText('HEROES-ANGEL-2026');
      alert('Código copiado al portapapeles.');
    };

    window.exportData = function() {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (!saved) return alert('No hay datos guardados.');
      navigator.clipboard.writeText(saved);
      alert('¡Datos copiados! Pégaselos por WhatsApp al otro celular.');
    };

    window.importData = function() {
      const jsonString = prompt('Pega el código de datos recibido:');
      if (!jsonString) return;
      try {
        JSON.parse(jsonString);
        localStorage.setItem(STORAGE_KEY, jsonString);
        alert('¡Datos importados con éxito!');
        location.reload();
      } catch (e) {
        alert('Código de datos no válido.');
      }
    };
  </script>
</body>
</html>