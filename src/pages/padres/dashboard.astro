---
// src/pages/padres/index.astro
import '../../styles/global.css';
---

<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Centro de Padres - Héroes en Casa</title>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen pb-24 font-sans">

  <!-- Header LimPIO con Campanita de Notificaciones y Salida Segura -->
  <header class="bg-slate-800 border-b border-slate-700 p-4 sticky top-0 z-30">
    <div class="max-w-md mx-auto flex justify-between items-center">
      <div class="flex items-center gap-2">
        <span class="text-xl">👨‍👩‍👦</span>
        <h1 class="font-black text-white text-base">Centro de Padres</h1>
      </div>

      <div class="flex items-center gap-2">
        <!-- 🔔 Campanita de Notificaciones con Contador Pendiente -->
        <a href="#pending-section" class="relative bg-slate-700 hover:bg-slate-600 p-2 rounded-xl border border-slate-600 transition flex items-center justify-center cursor-pointer">
          <span class="text-base">🔔</span>
          <span id="bell-badge" class="absolute -top-1 -right-1 bg-red-500 text-white font-bold text-[10px] w-4 h-4 rounded-full flex items-center justify-center shadow">0</span>
        </a>

        <a href="/" class="bg-slate-700 hover:bg-slate-600 active:scale-95 text-slate-200 text-xs font-bold py-2 px-3 rounded-xl border border-slate-600 shadow transition flex items-center gap-1 cursor-pointer">
          <span>🔒</span>
          <span>Salir</span>
        </a>
      </div>
    </div>
  </header>

  <main class="max-w-md mx-auto p-4 space-y-5">

    <!-- 💡 TARJETA DE BALANCE INTELIGENTE (Resumen de Comportamiento) -->
    <section class="bg-gradient-to-br from-slate-800 to-slate-800/90 p-4 rounded-3xl border border-slate-700 shadow-sm space-y-3">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="text-2xl">📊</span>
          <div>
            <h2 class="text-xs font-bold text-white uppercase tracking-wider">Balance Familiar</h2>
            <p id="behavior-summary-text" class="text-[11px] text-slate-400">Calculando estado actual...</p>
          </div>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-2 pt-1">
        <div class="bg-blue-950/40 border border-blue-500/20 p-2.5 rounded-2xl flex items-center justify-between">
          <span class="text-xs text-blue-300 font-bold">Fichas Azules 🔵</span>
          <span id="summary-blue" class="font-black text-blue-200 text-base">0</span>
        </div>
        <div class="bg-red-950/40 border border-red-500/20 p-2.5 rounded-2xl flex items-center justify-between">
          <span class="text-xs text-red-300 font-bold">Fichas Rojas 🔴</span>
          <span id="summary-red" class="font-black text-red-200 text-base">0</span>
        </div>
      </div>
    </section>

    <!-- ⚡ TARJETA DE ACCIÓN RÁPIDA: Super-Logros y Fichas con Motivo -->
    <section class="bg-slate-800 p-4 rounded-3xl border border-slate-700 shadow-sm space-y-4">
      <div class="flex items-center gap-2">
        <span class="text-xl">🌟</span>
        <div>
          <h2 class="text-xs font-bold text-white uppercase tracking-wider">Acciones Inmediatas</h2>
          <p class="text-[11px] text-slate-400">Otorga super-logros o registra ajustes de conducta.</p>
        </div>
      </div>

      <!-- Super Logro Rápido -->
      <form id="super-logro-form" class="space-y-2 bg-slate-900/60 p-3 rounded-2xl border border-slate-700/60">
        <span class="text-[10px] font-bold text-amber-400 uppercase">🚀 Otorgar Super-Logro (🔵)</span>
        <div class="flex gap-2">
          <input type="text" id="logro-title" placeholder="Ej. ¡Ayudó sin que se lo pidieran!" required class="w-full bg-slate-900 border border-slate-700 rounded-xl py-1.5 px-3 text-xs text-white outline-none focus:ring-2 focus:ring-amber-400" />
          <input type="number" id="logro-tokens" value="15" min="1" max="100" class="w-16 bg-slate-900 border border-slate-700 rounded-xl py-1.5 px-2 text-center text-xs font-bold text-blue-300 outline-none" />
        </div>
        <button type="submit" class="w-full bg-amber-500 hover:bg-amber-400 text-slate-950 font-black py-1.5 rounded-xl text-xs transition cursor-pointer">
          Otorgar Fichas Azules
        </button>
      </form>

      <!-- Ficha Roja con Motivo Obligatorio -->
      <form id="red-token-form" class="space-y-2 bg-slate-900/60 p-3 rounded-2xl border border-slate-700/60">
        <span class="text-[10px] font-bold text-red-400 uppercase">🔴 Registrar Ficha Roja (Con Motivo)</span>
        <input type="text" id="red-reason" placeholder="Motivo (ej. No quiso ordenar su cuarto)" required class="w-full bg-slate-900 border border-slate-700 rounded-xl py-1.5 px-3 text-xs text-white outline-none focus:ring-2 focus:ring-red-400" />
        <button type="submit" class="w-full bg-red-600 hover:bg-red-500 text-white font-bold py-1.5 rounded-xl text-xs transition cursor-pointer">
          Añadir 1 Ficha Roja y Guardar Motivo
        </button>
      </form>
    </section>

    <!-- ⏳ SECCIÓN DE APROBACIONES PENDIENTES (Campanita / Inmediato) -->
    <section id="pending-section" class="space-y-3">
      <div class="flex justify-between items-center">
        <h2 class="text-xs font-bold text-slate-400 uppercase tracking-wider">⏳ Solicitudes Pendientes</h2>
        <span id="pending-badge-count" class="text-xs font-bold bg-amber-500/20 text-amber-300 px-2.5 py-0.5 rounded-full border border-amber-500/30">0</span>
      </div>

      <div id="pending-container" class="space-y-2">
        <p class="text-xs text-slate-500 text-center py-4 bg-slate-800/40 rounded-2xl border border-slate-800">
          No hay solicitudes pendientes en este momento.
        </p>
      </div>
    </section>

    <!-- 🗺️ GRID DE TARJETAS DE NAVEGACIÓN A SUBPÁGINAS -->
    <section class="space-y-3 pt-2">
      <h2 class="text-xs font-bold text-slate-400 uppercase tracking-wider">📂 Secciones del Sistema</h2>
      
      <div class="grid grid-cols-2 gap-3">
        <!-- Misiones -->
        <a href="/padres/misiones" class="bg-slate-800 hover:bg-slate-750 p-4 rounded-2xl border border-slate-700 shadow-sm transition flex flex-col justify-between gap-3 group cursor-pointer">
          <div class="w-9 h-9 rounded-xl bg-blue-500/10 flex items-center justify-center text-lg text-blue-400 border border-blue-500/20 group-hover:scale-105 transition">
            🎯
          </div>
          <div>
            <h3 class="font-bold text-white text-xs">Misiones Diarias</h3>
            <p class="text-[10px] text-slate-400 mt-0.5">Crear y adaptar tareas</p>
          </div>
        </a>

        <!-- Tiendita -->
        <a href="/padres/tienda" class="bg-slate-800 hover:bg-slate-750 p-4 rounded-2xl border border-slate-700 shadow-sm transition flex flex-col justify-between gap-3 group cursor-pointer">
          <div class="w-9 h-9 rounded-xl bg-amber-500/10 flex items-center justify-center text-lg text-amber-400 border border-amber-500/20 group-hover:scale-105 transition">
            🎁
          </div>
          <div>
            <h3 class="font-bold text-white text-xs">Premios / Tiendita</h3>
            <p class="text-[10px] text-slate-400 mt-0.5">Catálogo y costos</p>
          </div>
        </a>

        <!-- Historial / Fichas Rojas -->
        <a href="/padres/historial" class="bg-slate-800 hover:bg-slate-750 p-4 rounded-2xl border border-slate-700 shadow-sm transition flex flex-col justify-between gap-3 group cursor-pointer">
          <div class="w-9 h-9 rounded-xl bg-red-500/10 flex items-center justify-center text-lg text-red-400 border border-red-500/20 group-hover:scale-105 transition">
            📜
          </div>
          <div>
            <h3 class="font-bold text-white text-xs">Historial de Conducta</h3>
            <p class="text-[10px] text-slate-400 mt-0.5">Bitácora de fichas rojas</p>
          </div>
        </a>

        <!-- Configuración Familiar -->
        <a href="/padres/configuracion" class="bg-slate-800 hover:bg-slate-750 p-4 rounded-2xl border border-slate-700 shadow-sm transition flex flex-col justify-between gap-3 group cursor-pointer">
          <div class="w-9 h-9 rounded-xl bg-purple-500/10 flex items-center justify-center text-lg text-purple-400 border border-purple-500/20 group-hover:scale-105 transition">
            ⚙️
          </div>
          <div>
            <h3 class="font-bold text-white text-xs">Configuración</h3>
            <p class="text-[10px] text-slate-400 mt-0.5">Perfil, avatar y códigos</p>
          </div>
        </a>
      </div>
    </section>

  </main>

  <!-- Script del Dashboard Principal -->
  <script>
    // @ts-nocheck
    const STORAGE_KEY = 'family_app_state_v1';

    function getState() {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (!saved) return { 
        childProfile: { name: 'Ángel', avatar: '👦', blueTokens: 0, redTokens: 0 },
        missions: [], rewards: [], pendingApprovals: [], redTokenHistory: [] 
      };
      return JSON.parse(saved);
    }

    function renderMainDashboard() {
      const state = getState();
      const profile = state.childProfile || { blueTokens: 0, redTokens: 0 };

      // Contadores
      const blueCount = profile.blueTokens ?? 0;
      const redCount = profile.redTokens ?? 0;

      document.getElementById('summary-blue').innerText = blueCount;
      document.getElementById('summary-red').innerText = redCount;

      // Mensaje de Balance Inteligente
      const summaryText = document.getElementById('behavior-summary-text');
      if (blueCount >= redCount) {
        summaryText.innerText = '¡Excelente progreso! Ángel va genial esta semana 🌟';
        summaryText.className = 'text-[11px] text-emerald-400 font-medium';
      } else {
        summaryText.innerText = 'Área de atención: requiere refuerzo positivo 🛡️';
        summaryText.className = 'text-[11px] text-red-400 font-medium';
      }

      // Campanita de Notificaciones
      const pending = state.pendingApprovals || [];
      document.getElementById('bell-badge').innerText = pending.length;
      document.getElementById('pending-badge-count').innerText = pending.length;

      // Render Aprobaciones Pendientes
      const pendingContainer = document.getElementById('pending-container');
      if (pendingContainer) {
        if (pending.length === 0) {
          pendingContainer.innerHTML = `
            <p class="text-xs text-slate-500 text-center py-4 bg-slate-800/40 rounded-2xl border border-slate-800">
              No hay solicitudes pendientes en este momento.
            </p>`;
        } else {
          pendingContainer.innerHTML = pending.map(item => `
            <div class="bg-slate-800 p-3.5 rounded-2xl border border-slate-700 flex items-center justify-between gap-3">
              <div>
                <span class="text-[10px] font-bold uppercase tracking-wider ${item.type === 'REWARD' ? 'text-amber-400' : 'text-blue-400'}">
                  ${item.type === 'REWARD' ? '🎁 Canje de Premio' : '🎯 Misión Completada'}
                </span>
                <h4 class="font-bold text-xs text-white mt-0.5">${item.title}</h4>
                <p class="text-[10px] text-slate-400">${item.tokens} 🔵</p>
              </div>
              <div class="flex gap-1.5 shrink-0">
                <button type="button" onclick="approveRequest('${item.id}', true)" class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs px-3 py-1.5 rounded-lg transition cursor-pointer">✓</button>
                <button type="button" onclick="approveRequest('${item.id}', false)" class="bg-red-600/80 hover:bg-red-500 text-white font-bold text-xs px-3 py-1.5 rounded-lg transition cursor-pointer">✕</button>
              </div>
            </div>
          `).join('');
        }
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      renderMainDashboard();

      // Guardar Super-Logro
      document.getElementById('super-logro-form')?.addEventListener('submit', (e) => {
        e.preventDefault();
        const title = document.getElementById('logro-title')?.value;
        const tokens = parseInt(document.getElementById('logro-tokens')?.value || '15', 10);
        if (!title) return;

        const state = getState();
        state.childProfile.blueTokens = (state.childProfile.blueTokens || 0) + tokens;
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
        
        alert(`¡Super-Logro otorgado! +${tokens} 🔵 sumados a ${state.childProfile.name}.`);
        e.target.reset();
        renderMainDashboard();
      });

      // Guardar Ficha Roja con Motivo
      document.getElementById('red-token-form')?.addEventListener('submit', (e) => {
        e.preventDefault();
        const reason = document.getElementById('red-reason')?.value.trim();
        if (!reason) return;

        const state = getState();
        state.childProfile.redTokens = (state.childProfile.redTokens || 0) + 1;
        
        if (!state.redTokenHistory) state.redTokenHistory = [];
        state.redTokenHistory.push({
          id: `red_${Date.now()}`,
          date: new Date().toLocaleString(),
          reason: reason
        });

        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
        alert('Ficha roja registrada correctamente con su respectivo motivo.');
        e.target.reset();
        renderMainDashboard();
      });
    });

    window.approveRequest = function(id, approved) {
      const state = getState();
      const req = (state.pendingApprovals || []).find(r => r.id === id);

      if (req && approved) {
        if (req.type === 'MISSION') {
          state.childProfile.blueTokens = (state.childProfile.blueTokens || 0) + req.tokens;
        }
      } else if (req && !approved && req.type === 'REWARD') {
        state.childProfile.blueTokens = (state.childProfile.blueTokens || 0) + req.tokens;
      }

      state.pendingApprovals = (state.pendingApprovals || []).filter(r => r.id !== id);
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      renderMainDashboard();
    };
  </script>
</body>
</html>