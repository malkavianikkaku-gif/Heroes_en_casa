---
// Props recibidas por el componente
interface Props {
  title: string;
  tokens: number;
  status: 'PENDING' | 'WAITING_APPROVAL' | 'APPROVED';
}

const { title, tokens, status } = Astro.props;
---

<div class="bg-white rounded-2xl p-4 shadow-md border-2 border-slate-100 flex items-center justify-between my-2">
  <div class="flex items-center gap-3">
    <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center font-bold text-lg">
      +{tokens}
    </div>
    <div>
      <h4 class="font-bold text-slate-800 text-base">{title}</h4>
      {status === 'WAITING_APPROVAL' && (
        <span class="text-xs font-semibold text-amber-600 animate-pulse">⏳ Esperando revisión...</span>
      )}
      {status === 'APPROVED' && (
        <span class="text-xs font-semibold text-emerald-600">✓ ¡Logro acreditado!</span>
      )}
    </div>
  </div>

  <div>
    {status === 'PENDING' && (
      <button class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-xl shadow-lg transition-transform active:scale-95 text-sm">
        ¡Listo!
      </button>
    )}
  </div>
</div>